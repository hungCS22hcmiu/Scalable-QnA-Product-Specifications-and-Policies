# --- Not published ------------------------------------------------------------
# docs/ is version-controlled: the frozen source of truth is the most valuable
# artifact here and a local-only copy is a single point of failure.
# .claude/ and .docs/ are tracked for exactly the same reason (2026-09-21). Both
# their READMEs already claimed it while this file said otherwise, and the task
# trail under .docs/work/ is what .docs/README.md calls the raw material for the
# design and evaluation chapters — leaving it with no history and no remote copy
# was the larger risk. Only per-machine state stays out.
.claude/settings.local.json
.claude/scheduled_tasks.lock
.claude/state/*
!.claude/state/.gitkeep

# Submitted prose stays off a public remote: a public copy of text that is also
# handed in can register as a plagiarism-detection match against its own author.
docs/learning/

# --- Corpus -------------------------------------------------------------------
# dev-v0 is author-written (worklog W05, 2026-08-15) — freely releasable, and
# tracking it keeps the W5/W6 results reproducible.
# v1 stays out until data-card.md §1's redistribution TODO is resolved: the
# Amazon-Reviews-2023 dataset card states no license and this remote is public.
# Un-ignore once the terms are verified, or ship a download+build script and a
# hash manifest instead of the raw data (ADR-013).
data/v1/
# v1-draft is the same unresolved licence, one directory earlier in the pipeline.
# fetch_corpus_v1.py's own header says "do not git add data/v1-draft/"; 175 files
# had been staged anyway. Regenerate it by re-running that script, don't track it.
data/v1-draft/

# --- Build output --------------------------------------------------------------
# Generated protobuf stubs (regenerate with `make proto`)
gateway/internal/ragpb/
rag/src/rag/pb/

# Go
gateway/gateway
gateway/bin/
*.test

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/

# Experiment figures regenerate from raw/ via `make figures`
experiments/results/*/figures/

# --- OS ------------------------------------------------------------------------
.DS_Store

# --- demo UI -------------------------------------------------------------------
# Source is tracked; the toolchain output is not. `make ui` regenerates dist/ from
# source, so shipping it would be a second copy of the same thing that can drift.
ui/node_modules/
ui/dist/
